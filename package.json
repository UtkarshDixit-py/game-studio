{
  "name": "game-studio",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "games/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run typecheck && npm run test && npm run build",
    "e2e": "playwright test",
    "dev": "npm run dev -w"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
